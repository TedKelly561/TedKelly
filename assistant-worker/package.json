{
  "name": "tedkelly-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker behind the 'Ask Ted's assistant' chat on tedkelly.dev",
  "type": "module",
  "scripts": {
    "knowledge": "node scripts/build-knowledge.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node test/integration.mjs",
    "test:widget": "node test/widget.e2e.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
